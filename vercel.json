{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/build-demo.js": {
      "maxDuration": 60,
      "memory": 256
    },
    "api/chat.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/lead-magnet-submit.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/booking-intent.js": {
      "maxDuration": 15,
      "memory": 256
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*\\.svg|.*\\.png|.*\\.jpg|.*\\.ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/industries/ecommerce",
      "destination": "/industries/retail-d2c"
    }
  ],
  "redirects": [
    {
      "source": "/industries/legal-compliance",
      "destination": "/who-we-help/professional-services",
      "permanent": true
    },
    {
      "source": "/industries/law-firms",
      "destination": "/who-we-help/professional-services",
      "permanent": true
    },
    {
      "source": "/industries/cpa-firms",
      "destination": "/who-we-help/professional-services",
      "permanent": true
    },
    {
      "source": "/industries/insurance",
      "destination": "/who-we-help/operations-heavy",
      "permanent": true
    },
    {
      "source": "/who-we-help",
      "destination": "/#who-we-help",
      "permanent": false
    },
    {
      "source": "/preview/home-v4",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/preview/ai-native-engineering",
      "destination": "/ai-native-engineering",
      "permanent": true
    },
    {
      "source": "/preview/who-we-help-:slug",
      "destination": "/who-we-help/:slug",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/insights/:slug",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/fractional-ai-officer",
      "destination": "/ai-engineering-governance",
      "permanent": true
    },
    {
      "source": "/aigov",
      "destination": "/ai-engineering-governance",
      "permanent": true
    },
    {
      "source": "/ai-governance",
      "destination": "/ai-engineering-governance",
      "permanent": true
    }
  ]
}
